# ==============================================================================
# Nimantran AI — Environment Configuration Template
# Copy this file to `.env` and fill in your actual production/development credentials.
# NEVER commit your `.env` file with real API keys or secrets to version control!
# ==============================================================================

# --- Application Core ---
PROJECT_NAME="Nimantran AI"
ENV=development
DEBUG=true
PORT=8000
API_V1_STR="/api/v1"
PUBLIC_BASE_URL="http://localhost:5173"
LOCAL_STORAGE_DIR="./uploads"

# --- Security & JWT ---
SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_EXPIRE_MINUTES=1440

# --- Database ---
# For SQLite (default development):
DATABASE_URL="sqlite+aiosqlite:///./nimantran.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/nimantran"

# --- Google Gemini AI Engine ---
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# --- Multi-Channel Messaging: WhatsApp Provider ---
# Set to 'meta' for live production or 'mock' for local simulation
WHATSAPP_PROVIDER_MODE="mock"
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_access_token"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_waba_id"
WHATSAPP_VERIFY_TOKEN="nimantran_webhook_token_2026"
WHATSAPP_APP_SECRET="your_meta_app_secret"

# --- Multi-Channel Messaging: SMS Provider ---
# Options: 'twilio', 'generic_http' (Fast2SMS), or 'mock'
SMS_PROVIDER="mock"
# Twilio credentials:
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_NUMBER="+1234567890"
# Fast2SMS credentials:
FAST2SMS_API_KEY="your_fast2sms_api_key"
FAST2SMS_SENDER_ID="NIMANT"

# --- Multi-Channel Messaging: Email Provider ---
# Options: 'smtp' or 'mock'
EMAIL_PROVIDER="mock"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="invitations@nimantran.ai"
SMTP_FROM_NAME="Nimantran AI Invitations"
SMTP_USE_TLS=true

# --- Redis (Optional for horizontal scale) ---
REDIS_URL="redis://localhost:6379/0"
