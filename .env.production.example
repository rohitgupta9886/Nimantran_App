# ==============================================================================
# Nimantran AI — Production Environment Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file to `.env.production` (or `.env` on your production server).
# 2. Fill in all required production secrets.
# 3. DO NOT commit `.env.production` or `.env` with real credentials to Git!
# ==============================================================================

# --- Application Core ---
APP_ENV=production
PROJECT_NAME="Nimantran AI"
PUBLIC_BASE_URL="https://your-domain.com"
FRONTEND_URL="https://your-domain.com"
PORT=8000
LOCAL_STORAGE_DIR="/app/uploads"

# --- Security & JWT (CRITICAL: Use high-entropy random strings in production) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_MIN_48_CHARS
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_MIN_48_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=1440

# --- PostgreSQL Database (Production Required) ---
POSTGRES_USER=nimantran
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_DB=nimantran_prod
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- Redis Cache & Queue Broker ---
REDIS_PASSWORD=CHANGE_ME_REDIS_AUTH_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# --- Google Gemini AI API ---
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY

# --- Meta WhatsApp Cloud API (Production Messaging) ---
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_META_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_META_PERMANENT_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME_META_WABA_ID
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_WEBHOOK_VERIFY_TOKEN
WHATSAPP_APP_SECRET=CHANGE_ME_META_APP_SECRET

# --- SMS Gateways (Twilio or Fast2SMS) ---
# Options: 'twilio', 'generic_http' (Fast2SMS)
SMS_PROVIDER=generic_http
# Fast2SMS (Indian Gateway):
FAST2SMS_API_KEY=CHANGE_ME_FAST2SMS_API_KEY
FAST2SMS_SENDER_ID=NIMANT
# Twilio (International SMS):
TWILIO_ACCOUNT_SID=CHANGE_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=CHANGE_ME_TWILIO_FROM_PHONE_NUMBER

# --- SMTP Production Email Service ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=invitations@your-domain.com
SMTP_FROM_NAME="Nimantran AI Celebrations"
SMTP_USE_TLS=true

# --- CORS Allowed Origins ---
CORS_ORIGINS="https://your-domain.com,https://www.your-domain.com"
