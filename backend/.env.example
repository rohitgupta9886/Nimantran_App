# ==============================================================================
# Nimantran AI — Backend Environment Configuration Template
# Copy this file to `backend/.env` and configure your credentials.
# ==============================================================================

PROJECT_NAME="Nimantran AI Backend"
ENV=development
DEBUG=true
PORT=8000
API_V1_STR="/api/v1"
PUBLIC_BASE_URL="http://localhost:5173"
LOCAL_STORAGE_DIR="./uploads"

# JWT & Security
SECRET_KEY="your-secret-key-for-jwt-signing"
JWT_ALGORITHM="HS256"
JWT_ACCESS_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite+aiosqlite:///./nimantran.db"

# AI
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
GEMINI_API_KEY="your_gemini_api_key"

# WhatsApp Cloud API
WHATSAPP_PROVIDER_MODE="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN="nimantran_webhook_token_2026"
WHATSAPP_APP_SECRET=""

# SMS Gateway
SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
FAST2SMS_API_KEY=""
FAST2SMS_SENDER_ID=""

# SMTP Email
EMAIL_PROVIDER="mock"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="invitations@nimantran.ai"
SMTP_FROM_NAME="Nimantran AI Invitations"
SMTP_USE_TLS=true
